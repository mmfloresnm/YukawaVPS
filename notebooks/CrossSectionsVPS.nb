Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HexToRGBColor", "[", "hex_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "g", ",", "b"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "g", ",", "b"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{"#", ",", "16"}], "]"}], "/", "255.0"}], "&"}], "/@", 
        RowBox[{"StringPartition", "[", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{"hex", ",", 
            RowBox[{"\"\<#\>\"", "->", "\"\<\>\""}]}], "]"}], ",", "2"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"r", ",", "g", ",", "b"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9611238255885553`*^9, 3.9611238255916023`*^9}},
 CellLabel->
  "In[292]:=",ExpressionUUID->"762e8f46-5608-4a0e-94b3-cec81720a43b"],

