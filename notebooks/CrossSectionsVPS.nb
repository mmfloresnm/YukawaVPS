Cell[BoxData[{
 RowBox[{
  RowBox[{"pyColors", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"HexToRGBColor", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
    "pythonColorHexes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PythonColor", "[", "name_String", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"col", "=", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"Association", "[", 
         RowBox[{"Rule", "@@@", "pyColors"}], "]"}], ",", 
        RowBox[{"ToLowerCase", "[", "name", "]"}], ",", "None"}], "]"}]}], 
     "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"col", "===", "None"}], ",", 
      RowBox[{
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"PythonColor", "::", "notfound"}], ",", "name"}], "]"}], ";",
        "\[IndentingNewLine]", "Gray"}], ",", 
      RowBox[{"(*", 
       RowBox[{"fallback", " ", "color"}], "*)"}], "col"}], "]"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.959224266839925*^9, 3.959224324607336*^9}, {
