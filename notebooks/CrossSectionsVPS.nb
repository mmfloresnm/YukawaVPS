    RowBox[{"a_", ",", "b_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"10.0", "^", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"a", ",", "b", ",", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}], "]"}]}], ",", "wprec"}], "]"}]}], 
