Cell[BoxData[
 RowBox[{
  RowBox[{"exportCSLMAXData", "[", 
   RowBox[{"grid_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"datDIR", "=", 
       RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"mask", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"gridMask", "[", "grid", "]"}], "]"}]}], ",", "dir", ",", 
      "files", ",", "\[Sigma]", ",", "lmax", ",", "sigSTR", ",", "lmaxSTR"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"$YukawaLabels", "[", "type", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"files", "=", 
        RowBox[{"FileNames", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", "\"\<PhaseShift\>\"", ",", 
             
             RowBox[{"\"\<PhaseShift_\>\"", "<>", "type", 
              "<>", "\"\<_l=*.txt\>\""}]}], "}"}], "]"}], ",", "datDIR"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Sigma]", ",", "lmax"}], "}"}], "=", 
           RowBox[{
            RowBox[{"$CSCalcFuncs", "[", "q", "]"}], "[", 
            RowBox[{"grid", ",", "files", ",", "type"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sigSTR", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "datDIR", ",", "dir", ",", "\"\<CrossSections\>\"", ",", 
              
              RowBox[{"\"\<sig\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>", 
               "type", "<>", "\"\<.txt\>\""}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"lmaxSTR", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"datDIR", ",", "dir", ",", "\"\<lmax\>\"", ",", 
              
              RowBox[{"\"\<lmax_\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>", 
               "type", "<>", "\"\<.txt\>\""}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"sigSTR", ",", 
            RowBox[{"Pick", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "\[Sigma]", "]"}], ",", "mask"}], "]"}],
             ",", "\"\<Table\>\""}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"lmaxSTR", ",", 
            RowBox[{
             RowBox[{"Pick", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", "lmax", "]"}], ",", "mask"}], "]"}], "/.",
              " ", 
             RowBox[{"Indeterminate", "->", 
              RowBox[{"-", "1"}]}]}], ",", "\"\<Table\>\""}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", 
           RowBox[{"OptionValue", "[", "\"\<Quantities\>\"", "]"}]}], "}"}]}],
         "\[IndentingNewLine]", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"type", ",", 
        RowBox[{"OptionValue", "[", "\"\<Types\>\"", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{4.001336302686208*^9, 4.001336328272667*^9}, {
  4.001382005182721*^9, 4.001382043938539*^9}, {4.0013825982271357`*^9, 
