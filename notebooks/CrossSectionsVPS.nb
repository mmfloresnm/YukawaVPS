          RowBox[{"partialSum", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], ",", "convIndices"}], "}"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "Quiet"}]}], 
  ";"}]}], "Input",
