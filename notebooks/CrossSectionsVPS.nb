Cell[TextData[{
 StyleBox["NOTE: ",
  FontWeight->"Bold"],
 "The precomputed data are not included in this repository. They are archived \
on Zenodo (",
 ButtonBox["doi:10.5281/zenodo.23475703",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.5281/zenodo.23475703"], None},
  ButtonNote->"https://doi.org/10.5281/zenodo.23475703"],
 ") and must be placed in ",
 StyleBox["../data/ ", "Code"],
 "(see ",
 StyleBox["../data/README.md", "Code"],
 "). Computing cross sections from phase shifts requires the phase-shift data."
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
