Cell[BoxData[
 RowBox[{
  RowBox[{"importCSLMAXData", "[", 
   RowBox[{"grid_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dir", ",", 
      RowBox[{"sigData", "=", 
       RowBox[{"<|", "|>"}]}], ",", 
      RowBox[{"lmaxData", "=", 
       RowBox[{"<|", "|>"}]}], ",", 
      RowBox[{"out", "=", 
       RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}]}], ",", 
      RowBox[{"want", "=", 
       RowBox[{"OptionValue", "[", "\"\<Data\>\"", "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dir", "=", 
         RowBox[{"$YukawaLabels", "[", "type", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<sigma\>\"", ",", "\"\<Both\>\""}], "}"}], ",", 
               "want"}], "]"}], ",", 
             RowBox[{
              RowBox[{"sigData", "[", 
               RowBox[{"{", 
                RowBox[{"type", ",", "q"}], "}"}], "]"}], "=", 
              RowBox[{"importDataOnGrid", "[", 
               RowBox[{
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"out", ",", "dir", ",", "\"\<CrossSections\>\"", ",", 
                   
                   RowBox[{"\"\<sig\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>", 
                    "type", "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
                "grid"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<lmax\>\"", ",", "\"\<Both\>\""}], "}"}], ",", 
               "want"}], "]"}], ",", 
             RowBox[{
              RowBox[{"lmaxData", "[", 
               RowBox[{"{", 
                RowBox[{"type", ",", "q"}], "}"}], "]"}], "=", 
              RowBox[{"importDataOnGrid", "[", 
               RowBox[{
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"out", ",", "dir", ",", "\"\<lmax\>\"", ",", 
                   
                   RowBox[{"\"\<lmax_\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>",
                     "type", "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
                "grid"}], "]"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", 
            RowBox[{"OptionValue", "[", "\"\<Quantities\>\"", "]"}]}], 
           "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"type", ",", 
         RowBox[{"OptionValue", "[", "\"\<Types\>\"", "]"}]}], "}"}]}], "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "want", ",", "\"\<sigma\>\"", ",", "sigData", ",", "\"\<lmax\>\"", ",", 
