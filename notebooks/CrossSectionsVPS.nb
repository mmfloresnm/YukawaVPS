Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "importGrid", "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "importGrid", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<OutputDirectory\>\"", "->", "\"\<../data/\>\""}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"importGrid", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ingrid", ",", "n\[Zeta]"}], "}"}], ",", 
    RowBox[{
     RowBox[{"ingrid", "=", 
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}], 
           ",", "\"\<zetaVSxi_grid.txt\>\""}], "}"}], "]"}], 
        ",", "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n\[Zeta]", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Union", "[", 
        RowBox[{"ingrid", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Partition", "[", 
      RowBox[{"ingrid", ",", "n\[Zeta]"}], "]"}]}]}], "]"}]}]}], "Input",
