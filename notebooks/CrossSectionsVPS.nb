Cell[BoxData[{
 RowBox[{"Clear", "[", "etaOnGrid", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaOnGrid", "[", "grid_", "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"ArcSinh", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}]}], "&"}], ",", 
     "grid", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0010681776363993`*^9, 4.0010681834003963`*^9}, 
   4.001083705596416*^9, 4.001338692485613*^9},
 CellLabel->
  "In[319]:=",ExpressionUUID->"32f256f2-74df-40a2-93d0-8139991b763a"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "convCalc", "]"}], "\n", 
 RowBox[{
  RowBox[{"convCalc", "[", 
   RowBox[{"list_", ",", " ", "\[Eta]_", ",", " ", 
    RowBox[{"tol_", " ", ":", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}], ",", " ", 
    RowBox[{"run_", " ", ":", " ", "1"}]}], "]"}], " ", ":=", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "S", ",", " ", "eps", ",", " ", "n", ",", " ", "bad", ",", " ", 
      "lastBad", ",", " ", "thr"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"list", ",", " ", "Indeterminate"}], "]"}]}], ",", " ", 
       RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"NumericQ", "[", "\[Eta]", "]"}]}], " ", "||", " ", 
        RowBox[{"\[Eta]", " ", "<=", " ", "0"}]}], ",", " ", 
       RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"thr", " ", "=", " ", 
      RowBox[{"tol", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[Eta]"}], "]"}]}], ")"}]}]}], ";", "\n",
      "  ", 
     RowBox[{"S", " ", "=", " ", 
      RowBox[{"Accumulate", "[", "list", "]"}]}], ";", "\n", "  ", 
     RowBox[{"eps", " ", "=", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "S", "]"}], " ", "-", " ", 
         RowBox[{"Most", "[", "S", "]"}]}], "]"}], "/", 
       RowBox[{"Abs", "[", 
        RowBox[{"Most", "[", "S", "]"}], "]"}]}]}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eps", ",", " ", 
          RowBox[{"Indeterminate", " ", "|", " ", "ComplexInfinity"}]}], 
         "]"}]}], ",", " ", "\n", "   ", 
       RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"n", " ", "=", " ", 
