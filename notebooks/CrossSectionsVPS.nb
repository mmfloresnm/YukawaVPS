Cell[BoxData[{
 RowBox[{"Clear", "[", "importDataOnGrid", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"importDataOnGrid", "[", 
    RowBox[{"file_", ",", "grid_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "mask", ",", 
       RowBox[{"k", "=", "1"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Import", "[", 
         RowBox[{"file", ",", "\"\<Table\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mask", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Log10", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ">=", 
           RowBox[{
            RowBox[{"Log10", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", "1", "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}]}], "&"}], ",", "grid", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{"mask", ",", "True", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "=!=", 
         RowBox[{"Length", "[", "data", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"importDataOnGrid", "::", "len"}], ",", "file", ",", 
           RowBox[{"Count", "[", 
            RowBox[{"mask", ",", "True", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"k", "++"}], "]"}], "]"}], ",", "Indeterminate"}], "]"}],
          "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"mask", ",", "grid"}], "}"}], ",", "2"}], "]"}]}]}], "]"}]}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
