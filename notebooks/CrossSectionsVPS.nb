Cell[TextData[{
 "Modules for computing normalized scattering cross sections using phase \
shift data as well as\nexporting and importing of precomputed data.\n\nNote \
that the assumed data file path is ",
 StyleBox["../data", "Code"],
 ". This can be changed either by manually adjusting\n",
 StyleBox["\[OpenCurlyDoubleQuote]OutputDirectory\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]../data/\[CloseCurlyDoubleQuote]", "Code"],
 " in\n\t\n\t",
 StyleBox["Import phase shifts & compute and ",
  FontSlant->"Italic"],
 StyleBox["export",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" cross sections",
  FontSlant->"Italic"],
 " \[LongRightArrow] ",
 StyleBox["Compute cross sections",
  FontSlant->"Italic"],
 "\n\t\nor by using the ",
 StyleBox["\[OpenCurlyDoubleQuote]OutputDirectory\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]../data/\[CloseCurlyDoubleQuote]", "Code"],
 " as within the relevant functions e.g.,\n\n",
 StyleBox["exportCSLMAXData[grid, \[OpenCurlyDoubleQuote]OutputDirectory\
\[CloseCurlyDoubleQuote] -> \[OpenCurlyDoubleQuote]/new_dir/\
\[CloseCurlyDoubleQuote]]", "Code"],
 "\n\nor\n\n",
 StyleBox["importCSLMAXData[grid,\[OpenCurlyDoubleQuote]A\
\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]elas\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]OutputDirectory\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]/new_dir/\[CloseCurlyDoubleQuote]]", "Code"]
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
