Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Sigma]elasGridCalc", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]elasGridCalc", "[", 
    RowBox[{"grid_", ",", "files_", ",", 
     RowBox[{"label_String", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "PS", ",", "res", ",", "i", ",", "partialSum", ",", "convIndices", ",",
         "eta"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eta", "=", 
        RowBox[{"etaOnGrid", "[", "grid", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"res", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "files", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "0"}], ",", 
           RowBox[{"i", "<=", 
            RowBox[{
             RowBox[{"Length", "[", "files", "]"}], "-", "1"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"PS", "=", 
             RowBox[{"importDataOnGrid", "[", 
              RowBox[{
               RowBox[{"files", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "grid"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"PS", "===", "$Failed"}], ",", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"\"\<Grid/file mismatch: \>\"", ",", 
                 RowBox[{"files", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], ";", 
               RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "PS", "]"}], ">", "0"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "i"}], "+", "1"}], ")"}], "*", 
                 RowBox[{
                  RowBox[{"Sin", "[", "PS", "]"}], "^", "2"}]}]}], ";"}]}], 
             "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Sigma]elas (\>\"", ",", " ", "label", ",", 
            " ", "\"\<) - processing file \>\"", ",", 
            RowBox[{"i", "+", "1"}], ",", "\"\< of \>\"", ",", 
            RowBox[{"Length", "[", "files", "]"}], ",", "\"\<: \>\"", ",", 
            RowBox[{"ProgressIndicator", "[", 
             RowBox[{"i", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "files", "]"}], "-", "1"}]}], "}"}]}],
              "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"partialSum", "=", 
        RowBox[{"Accumulate", "[", "res", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"convIndices", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"convCalc", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"res", ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
            "eta"}], "}"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"partialSum", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], ",", "convIndices"}], "}"}], 
        "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "//", 
    "Quiet"}]}], ";"}]}], "Input",
