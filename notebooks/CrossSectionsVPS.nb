  RowBox[{"importCSLMAXData", "[", 
   RowBox[{"grid_", ",", "type_String", ",", "q_String", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}]}], ",", 
      RowBox[{"want", "=", 
       RowBox[{"OptionValue", "[", "\"\<Data\>\"", "]"}]}], ",", "sig", ",", 
      "lmax"}], "}"}], ",", 
    RowBox[{
     RowBox[{"sig", ":=", 
      RowBox[{"importDataOnGrid", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"out", ",", 
           RowBox[{"$YukawaLabels", "[", "type", "]"}], 
           ",", "\"\<CrossSections\>\"", ",", 
           
           RowBox[{"\"\<sig\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>", "type", 
            "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", "grid"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"lmax", ":=", 
      RowBox[{"importDataOnGrid", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"out", ",", 
           RowBox[{"$YukawaLabels", "[", "type", "]"}], ",", "\"\<lmax\>\"", ",", 
           
           RowBox[{"\"\<lmax_\>\"", "<>", "q", "<>", "\"\<_\>\"", "<>", 
            "type", "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", "grid"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "want", ",", "\"\<sigma\>\"", ",", "sig", ",", "\"\<lmax\>\"", ",", 
       "lmax", ",", "_", ",", 
       RowBox[{"{", 
        RowBox[{"sig", ",", "lmax"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[343]:=",ExpressionUUID->"84ec38ea-dd4a-4b26-abb5-6dfd37f92774"]
}, Closed]],

