Cell[BoxData[
 RowBox[{"Clear", "[", "makeInterp", "]"}]], "Input",
 CellChangeTimes->{{3.9995888525707703`*^9, 3.999588858086514*^9}},
 CellLabel->
  "In[344]:=",ExpressionUUID->"65fe2fc4-7524-465e-bc1f-605f9d150449"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeInterp", "::", "outdom"}], 
    "=", "\"\<Point (`1`, `2`) is outside the interpolation domain \[Xi] \
\[Element] [`3`, `4`], \[Zeta] \[Element] [`5`, `6`]. Returning \
Indeterminate.\>\""}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"makeInterp", "[", 
   RowBox[{"grid_", ",", "data_", ",", 
    RowBox[{"order_", ":", "1"}], ",", 
    RowBox[{"warn_", ":", "True"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xiAxis", ",", "zetaAxis", ",", "lxi", ",", "lzeta", ",", "lsig", ",", 
      "valid", ",", "fill", ",", "lsigF", ",", "iSig", ",", "iMask", ",", 
      "xmin", ",", "xmax", ",", "zmin", ",", "zmax"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xiAxis", "=", 
      RowBox[{"grid", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"zetaAxis", "=", 
      RowBox[{"grid", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xmin", ",", "xmax"}], "}"}], "=", 
      RowBox[{"MinMax", "[", "xiAxis", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"zmin", ",", "zmax"}], "}"}], "=", 
      RowBox[{"MinMax", "[", "zetaAxis", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"lxi", "=", 
      RowBox[{"Log10", "[", "xiAxis", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lzeta", "=", 
      RowBox[{"Log10", "[", "zetaAxis", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"lsig", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
            RowBox[{"#", ">", "0"}]}], ",", 
           RowBox[{"Log10", "[", "#", "]"}], ",", "Indeterminate"}], "]"}], 
         "&"}], ",", "data", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"valid", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumericQ", "[", "#", "]"}], ",", "1.", ",", "0."}], "]"}],
          "&"}], ",", "lsig", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fill", "=", 
      RowBox[{"Mean", "@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", "lsig", "]"}], ",", "NumericQ"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"lsigF", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumericQ", "[", "#", "]"}], ",", "#", ",", "fill"}], 
          "]"}], "&"}], ",", "lsig", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iSig", "=", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{"lsigF", ",", 
        RowBox[{"{", 
         RowBox[{"lxi", ",", "lzeta"}], "}"}], ",", 
        RowBox[{"InterpolationOrder", "->", "order"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"iMask", "=", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{"valid", ",", 
        RowBox[{"{", 
         RowBox[{"lxi", ",", "lzeta"}], "}"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xi", ",", "zeta"}], "}"}], ",", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"NumericQ", "[", "xi", "]"}], "&&", 
             RowBox[{"NumericQ", "[", "zeta", "]"}]}], ")"}]}], "||", 
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"xmin", "<=", "xi", "<=", "xmax"}], "&&", 
             RowBox[{"zmin", "<=", "zeta", "<=", "zmax"}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"warn", ",", 
            RowBox[{"Message", "[", 
             RowBox[{
              RowBox[{"makeInterp", "::", "outdom"}], ",", "xi", ",", "zeta", 
              ",", "xmin", ",", "xmax", ",", "zmin", ",", "zmax"}], "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", "Indeterminate"}], ",", 
         RowBox[{
          RowBox[{"xi", ">", 
           RowBox[{"10", " ", "zeta"}]}], "||", 
          RowBox[{
           RowBox[{"iMask", "[", 
            RowBox[{
             RowBox[{"Log10", "[", "xi", "]"}], ",", 
             RowBox[{"Log10", "[", "zeta", "]"}]}], "]"}], "<", 
           RowBox[{"1.", "-", 
            RowBox[{"10", "^", 
             RowBox[{"-", "9"}]}]}]}]}], ",", "Indeterminate", ",", "True", ",", 
         RowBox[{"10", "^", 
          RowBox[{"iSig", "[", 
           RowBox[{
            RowBox[{"Log10", "[", "xi", "]"}], ",", 
            RowBox[{"Log10", "[", "zeta", "]"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9995886618872347`*^9, 3.9995886790643597`*^9}, {
   3.999588847442636*^9, 3.999588851266183*^9}, 4.0002837036242447`*^9},
 CellLabel->
