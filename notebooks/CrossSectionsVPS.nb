            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "PS", "]"}], ">", "0"}], "&&", 
               RowBox[{
                RowBox[{"Length", "[", "PS2", "]"}], ">", "0"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "2"}], ")"}]}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", " ", "i"}], "+", "3"}], ")"}]}], "*", 
                 RowBox[{
                  RowBox[{"Sin", "[", 
                   RowBox[{"PS2", "-", "PS"}], "]"}], "^", "2"}]}]}], ";"}]}],
              "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Sigma]V (\>\"", ",", " ", "label", ",", 
            " ", "\"\<) - processing file \>\"", ",", 
            RowBox[{"i", "+", "1"}], ",", "\"\< of \>\"", ",", 
            RowBox[{
             RowBox[{"Length", "[", "files", "]"}], "-", "2"}], 
            ",", "\"\<: \>\"", ",", 
            RowBox[{"ProgressIndicator", "[", 
             RowBox[{"i", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "files", "]"}], "-", "3"}]}], "}"}]}],
              "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"partialSum", "=", 
        RowBox[{"Accumulate", "[", "res", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"convIndices", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"convCalc", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"res", ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
            "eta"}], "}"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
