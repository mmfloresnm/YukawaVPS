Cell[TextData[{
 StyleBox["exportData", "Code"],
 "\nFollowing a run of ",
 StyleBox["VPSSolve", "Code"],
 " export the data to the path given.\n\nPath should be of the form: ",
 StyleBox["./path", "Code"],
 "\n\nFiles are written directly into the given path. To use them with the \
import modules, move them into the folder structure of ",
 StyleBox["../data/", "Code"],
 ", e.g., ",
 StyleBox["AttractiveYukawa/Sommerfeld/", "Code"],
 "."
}], "Text",
