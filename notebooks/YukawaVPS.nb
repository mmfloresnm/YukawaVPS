Cell[TextData[{
 StyleBox["importSommerfeldData", "Code"],
 "\nImport Sommerfeld data for a given partial wave. One can also specify \
attractive \[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote] or repulsive \
\[OpenCurlyDoubleQuote]R\[CloseCurlyDoubleQuote].\n\n",
 StyleBox["Usage",
  FontWeight->"Bold"],
 ":\n\t",
 StyleBox["S0 = importSommerfeldData[grid, \[OpenCurlyDoubleQuote]A\
\[CloseCurlyDoubleQuote], 0];", "Code"],
 "\nor",
 StyleBox["\n\t S = importSommerfeldData[grid, \[OpenCurlyDoubleQuote]Types\
\[CloseCurlyDoubleQuote] -> \
{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote]}, \
\[OpenCurlyDoubleQuote]lValues\[CloseCurlyDoubleQuote] -> {0, 1, 2}];\n\tS0 = \
S[{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote],0}];\n\t\n", "Code"],
 "Note that the assumed data file path is ",
 StyleBox["../data", "Code"],
 ". \n\t\n",
 StyleBox["importSommerfeldData[grid,\[OpenCurlyDoubleQuote]Types\
\[CloseCurlyDoubleQuote]->{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote]},\
\[OpenCurlyDoubleQuote]lValues\[CloseCurlyDoubleQuote]->{0,1,2}, \
\[OpenCurlyDoubleQuote]OutputDirectory\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]/new_dir/\[CloseCurlyDoubleQuote]]", "Code"]
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
