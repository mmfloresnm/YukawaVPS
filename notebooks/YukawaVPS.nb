Cell[BoxData[
 RowBox[{"Clear", "[", "dataOutput", "]"}]], "Input",
 CellChangeTimes->{{4.000270821830489*^9, 4.000270822349704*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"b43e36b6-3795-4d08-a009-2a80173a5858"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dataOutput", "[", 
   RowBox[{"\[Zeta]range_", ",", "\[Xi]range_", ",", "l_", ",", 
    RowBox[{"\[CapitalDelta]\[Zeta]_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "100"}], ")"}]}]}], ",", 
    RowBox[{"\[CapitalDelta]\[Xi]_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "100"}], ")"}]}]}], ",", 
    RowBox[{"sign", ":", 
     RowBox[{"(", 
      RowBox[{"_", "?", "IntegerQ"}], ")"}], ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]min", ",", "\[Zeta]max", ",", "\[Xi]min", ",", "\[Xi]max", ",", 
      "n\[Xi]", ",", "n\[Zeta]", ",", "data", ",", "PS", ",", "SF"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "!=", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]min", ",", "\[Zeta]max"}], "}"}], "=", 
      "\[Zeta]range"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Xi]min", ",", "\[Xi]max"}], "}"}], "=", "\[Xi]range"}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"n\[Xi]", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Log10", "[", "\[Xi]max", "]"}], "-", 
          RowBox[{"Log10", "[", "\[Xi]min", "]"}]}], ")"}], "/", 
        RowBox[{"Log10", "[", "\[CapitalDelta]\[Xi]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n\[Zeta]", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Log10", "[", "\[Zeta]max", "]"}], "-", 
          RowBox[{"Log10", "[", "\[Zeta]min", "]"}]}], ")"}], "/", 
        RowBox[{"Log10", "[", "\[CapitalDelta]\[Zeta]", "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"log\[Zeta]", ">=", 
           RowBox[{"log\[Xi]", "-", "1"}]}], ",", 
          RowBox[{"VPSSolve", "[", 
           RowBox[{
            RowBox[{"10", "^", "log\[Zeta]"}], ",", 
            RowBox[{"10", "^", "log\[Xi]"}], ",", "l", ",", "sign"}], "]"}], ",",
           "Nothing"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"log\[Xi]", ",", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", "\[Xi]min", "]"}], ",", 
            RowBox[{"Log10", "[", "\[Xi]max", "]"}], ",", "n\[Xi]"}], "]"}]}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"log\[Zeta]", ",", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", "\[Zeta]min", "]"}], ",", 
            RowBox[{"Log10", "[", "\[Zeta]max", "]"}], ",", "n\[Zeta]"}], 
           "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"PS", ",", "SF"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"N", "[", "data", "]"}], "]"}], ",", "2"}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"PS", ",", "SF"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.993437020234262*^9, 3.993437058753047*^9}, 
   3.993437237448574*^9, {3.993437516194414*^9, 3.993437517258676*^9}, 
