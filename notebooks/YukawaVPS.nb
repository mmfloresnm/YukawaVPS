   3.993612019183895*^9, 3.9936120345578337`*^9}, {3.993613169261722*^9, 
   3.9936131730616627`*^9}, {3.993614376109667*^9, 3.9936144991497*^9}, {
   3.993781903198234*^9, 3.993782149934527*^9}, {3.993782200115779*^9, 
   3.9937823196173973`*^9}, {3.9937867553355713`*^9, 3.993786795533279*^9}, {
   3.993805546989297*^9, 3.993805551520041*^9}, {3.9941308004381313`*^9, 
