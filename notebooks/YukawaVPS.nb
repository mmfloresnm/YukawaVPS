Cell[BoxData[
 RowBox[{
  RowBox[{"TestEvent", "[", 
   RowBox[{"list_", ",", "eps_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "list", "]"}], "<", "2"}], 
    ",", "\"\<RestartIntegration\>\"", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "/", 
          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"-", "2"}], "]"}], "]"}]}], "-", "1"}], "]"}], ">", 
       "eps"}], ",", "\"\<RestartIntegration\>\"", 
      ",", "\"\<StopIntegration\>\""}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"c83df74f-7179-46d2-ad8f-8b710d9f95e0"],

Cell[TextData[{
 StyleBox["VPSSolve", "Code"],
 " \nPrimary module of this notebook.  Computes phase shift and Sommerfeld \
factor. The halting condition is based on the convergence of the phase shift, \
determined by ",
 StyleBox["tol", "Code"],
 ". \n\nThe ",
 StyleBox["sign", "Code"],
 " parameter determines the nature of the force (+1 for attractive, -1 for \
repulsive)\n\n",
 StyleBox["prec", "Code"],
 " denotes the initial WorkingPrecision. Should the integration fail to reach \
convergence within the specified range,\nthe computation is restarted with ",
 StyleBox["prec+10", "Code"],
 ". Recursion stops at ",
 StyleBox["prec >= 110", "Code"],
 " to prevent runaway."
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
   3.957249851205552*^9, 3.9572499276515427`*^9}, {3.957411993198291*^9, 
   3.957411993481557*^9}, {3.9574122324438887`*^9, 3.957412257207024*^9}, 
   3.9578388871122503`*^9, {3.957840203210361*^9, 3.9578402277790003`*^9}, {
   3.960953341367017*^9, 3.960953341619423*^9}, {3.992421535441804*^9, 
   3.992421546468717*^9}, {3.9924215868183937`*^9, 3.9924216179728394`*^9}, {
   3.992484314985977*^9, 3.992484315318488*^9}, 3.992493321059032*^9, {
   3.993263284122074*^9, 3.993263285277836*^9}, {3.9936078200971327`*^9, 
