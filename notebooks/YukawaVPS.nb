Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"logspace", "[", 
    RowBox[{"a_", ",", "b_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"10.0", "^", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"a", ",", "b", ",", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}], "]"}]}], ",", "wprec"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.959826540916465*^9, 3.959826542914359*^9}},
 CellLabel->
  "In[389]:=",ExpressionUUID->"4c08a4a8-1eaf-4953-90a5-6705011484cc"],

