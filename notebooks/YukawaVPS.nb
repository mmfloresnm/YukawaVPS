Cell[TextData[{
 StyleBox["NOTE: ",
  FontWeight->"Bold"],
 "The precomputed data are not included in this repository. They are archived \
on Zenodo (",
 ButtonBox["doi:10.5281/zenodo.23475703",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.5281/zenodo.23475704"], None},
  ButtonNote->"https://doi.org/10.5281/zenodo.23475704"],
 ") and must be placed in ",
 StyleBox["../data/ ", "Code"],
 "(see ",
 StyleBox["../data/README.md", "Code"],
 "). The calculation routines do not require the data; only the import and \
interpolation examples do."
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
