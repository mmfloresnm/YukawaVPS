Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["TZetaScan", "Code"], "[", 
   RowBox[{"\[Zeta]s_", ",", 
    RowBox[{"\[Xi]0_", "?", "NumericQ"}], ",", 
    RowBox[{"sign", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "1"}], ",", 
    RowBox[{"prec", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "32"}], ",", 
    RowBox[{"tol", ":", 
     RowBox[{"_", "?", "NumericQ"}], ":", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]", ",", "\[Xi]", ",", "khat", ",", "l", ",", " ", "g01OVERkLIST",
       ",", "g01OVERkD", ",", "Tt"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Xi]", "=", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{"\[Xi]0", ",", "wprec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"g01OVERkD", "=", 
      RowBox[{
       RowBox[{"LinCoeffCalc", "[", 
        RowBox[{"1", ",", "\[Xi]", ",", "sign"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"g01OVERkLIST", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LinCoeffCalc", "[", 
          RowBox[{
           RowBox[{"\[Zeta]s", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "\[Xi]", ",", "sign"}], 
          "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "\[Zeta]s", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Tt", " ", "=", " ", 
      RowBox[{"g01OVERkLIST", " ", "-", " ", 
       RowBox[{"\[Zeta]s", "*", "g01OVERkD"}]}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "Tt", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
