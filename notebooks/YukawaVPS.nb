 ".\n- Preserves the sign and returns \[OpenCurlyDoubleQuote]0\
\[CloseCurlyDoubleQuote] for zero."
}], "Text",
 CellChangeTimes->{{3.957238754306014*^9, 3.957238900288803*^9}, {
  3.9572389356337137`*^9, 3.9572389793828707`*^9}, {3.999598689341704*^9, 
  3.999598735449209*^9}, {3.999598916641753*^9, 3.999599017838706*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"fc5205f0-a079-4d52-8c64-c47f0dae49ef"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "texNum", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"texNum", "[", 
   RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{"Sign", "[", "x", "]"}]}], ",", "m", ",", "e", ",", "a", ",", 
      "b", ",", "aStr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x", "==", "0"}], ",", 
       RowBox[{"Return", "[", "\"\<0\>\"", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "e"}], "}"}], "=", 
      RowBox[{"MantissaExponent", "[", 
       RowBox[{"Abs", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"10.", " ", "m"}], ",", "0.01"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"e", "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"a", ">=", "10"}], ",", 
       RowBox[{
        RowBox[{"a", "=", "1."}], ";", 
        RowBox[{"b", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"aStr", "=", 
      RowBox[{"trimZeros", "@", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"a", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"s", "<", "0"}], ",", "\"\<-\>\"", ",", "\"\<\>\""}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "==", "0"}], "||", 
          RowBox[{"b", "==", "1"}]}], ",", 
         RowBox[{"trimZeros", "@", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"10", "^", "b"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"aStr", "==", "\"\<1\>\""}], ",", 
