Cell[BoxData[
 RowBox[{
  RowBox[{"LinCoeffCalc", "[", 
   RowBox[{
    RowBox[{"\[Zeta]0_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Xi]0_", "?", "NumericQ"}], ",", 
    RowBox[{"sign", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "1"}], ",", 
    RowBox[{"prec", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "32"}], ",", 
    RowBox[{"tol", ":", 
     RowBox[{"_", "?", "NumericQ"}], ":", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]", ",", "\[Xi]", ",", "l", ",", " ", "sol", ",", "S0", ",", 
      "tcl", ",", " ", "tsl", ",", " ", "xmin", ",", " ", "Ck", ",", 
      "g01OVERk"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]", ",", "\[Xi]"}], "}"}], "=", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sign", " ", 
           RowBox[{"Abs", "[", "\[Zeta]0", "]"}]}], ",", 
          RowBox[{"Abs", "[", "\[Xi]0", "]"}]}], "}"}], ",", "wprec"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sol", ",", "S0"}], "}"}], " ", "=", " ", 
      RowBox[{"IrregSolve", "[", 
       RowBox[{
       "\[Zeta]", ",", "\[Xi]", ",", "sign", ",", "prec", ",", "tol"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"tcl", "=", 
      RowBox[{"cl", "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tsl", "=", 
      RowBox[{"sl", "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"xmin", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"tcl", "[", "\"\<Domain\>\"", "]"}], "//", "Flatten"}], "//", 
       "Min"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Ck", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"tcl", "[", "x", "]"}], "-", 
         RowBox[{
          FractionBox[
           RowBox[{"2", "\[Zeta]"}], "S0"], "*", 
          RowBox[{"Log", "[", 
           RowBox[{"\[Zeta]", "*", "x"}], "]"}]}]}], ")"}], "/.", 
       RowBox[{"x", "->", "xmin"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"g01OVERk", " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "S0"}], 
       RowBox[{"(", 
        RowBox[{"Ck", "-", 
         FractionBox[
          RowBox[{"2", "\[Zeta]"}], "S0"]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"Ck", ",", " ", "g01OVERk"}], "}"}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.997669912525536*^9, 3.997669960259078*^9}, {
