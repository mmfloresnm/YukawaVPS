Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VPSSolve", "[", 
    RowBox[{
     RowBox[{"\[Zeta]0_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Xi]0_", "?", "NumericQ"}], ",", 
     RowBox[{"l_", "?", "IntegerQ"}], ",", 
     RowBox[{"sign", ":", 
      RowBox[{"(", 
       RowBox[{"_", "?", "IntegerQ"}], ")"}], ":", "1"}], ",", 
     RowBox[{"prec", ":", 
      RowBox[{"(", 
       RowBox[{"_", "?", "IntegerQ"}], ")"}], ":", "32"}], ",", 
     RowBox[{"tol", ":", 
      RowBox[{"(", 
       RowBox[{"_", "?", "NumericQ"}], ")"}], ":", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]]}], ",", " ", 
     RowBox[{"outall_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Zeta]", ",", "\[Xi]", ",", "xi", ",", "xf", ",", "sol", ",", "clf", ",",
        "slf", ",", "end", ",", "data\[Delta]", ",", "xm"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", "sign", "]"}], "!=", "1"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Zeta]", ",", "\[Xi]"}], "}"}], "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sign", "*", 
            RowBox[{"Abs", "[", "\[Zeta]0", "]"}]}], ",", 
           RowBox[{"Abs", "[", "\[Xi]0", "]"}]}], "}"}], ",", "wprec"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", " ", "=", " ", 
       RowBox[{"calcxmin", "[", 
        RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "l"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xf", " ", "=", " ", 
       RowBox[{"calcxmax", "[", 
        RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "l"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"end", " ", "=", " ", "xf"}], ";", "\[IndentingNewLine]", 
      RowBox[{"data\[Delta]", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"cl", "'"}], "[", "x", "]"}], "==", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Vv", "[", 
               RowBox[{"x", ",", "\[Zeta]", ",", "\[Xi]"}], "]"}]}], " ", "*", 
             RowBox[{"hy", "[", 
              RowBox[{"l", ",", "x"}], "]"}], " ", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"cl", "[", "x", "]"}], 
                RowBox[{"hj", "[", 
                 RowBox[{"l", ",", "x"}], "]"}]}], "-", 
               RowBox[{
                RowBox[{"sl", "[", "x", "]"}], 
                RowBox[{"hy", "[", 
                 RowBox[{"l", ",", "x"}], "]"}]}]}], " ", ")"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"sl", "'"}], "[", "x", "]"}], "==", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Vv", "[", 
               RowBox[{"x", ",", "\[Zeta]", ",", "\[Xi]"}], "]"}]}], " ", "*", 
             RowBox[{"hj", "[", 
              RowBox[{"l", ",", "x"}], "]"}], " ", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"cl", "[", "x", "]"}], 
                RowBox[{"hj", "[", 
                 RowBox[{"l", ",", "x"}], "]"}]}], "-", 
               RowBox[{
                RowBox[{"sl", "[", "x", "]"}], 
                RowBox[{"hy", "[", 
                 RowBox[{"l", ",", "x"}], "]"}]}]}], " ", ")"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"cl", "[", "xi", "]"}], "==", " ", 
            RowBox[{"cl0", "[", 
             RowBox[{"xi", ",", "\[Zeta]", ",", "l"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"sl", "[", "xi", "]"}], "==", " ", 
            RowBox[{"sl0", "[", 
             RowBox[{"xi", ",", "\[Zeta]", ",", "l"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"xm", "[", "xi", "]"}], "==", 
            RowBox[{"xf", "/", "100"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{"x", "==", 
              RowBox[{"xm", "[", "x", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"data\[Delta]", ",", 
                 RowBox[{"ArcTan", "[", 
                  RowBox[{
                   RowBox[{"sl", "[", "x", "]"}], "/", 
                   RowBox[{"cl", "[", "x", "]"}]}], "]"}]}], "]"}], ",", 
               RowBox[{"end", "=", 
                RowBox[{"xm", "[", "x", "]"}]}], ",", 
               RowBox[{
                RowBox[{"xm", "[", "x", "]"}], "->", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"xm", "[", "x", "]"}], "+", "10"}], ")"}]}], ",", 
               RowBox[{"TestEvent", "[", 
                RowBox[{"data\[Delta]", ",", "tol"}], "]"}]}], "}"}]}], 
            "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"cl", ",", "sl"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xi", ",", "xf"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DiscreteVariables", "->", 
          RowBox[{"Element", "[", 
           RowBox[{"xm", ",", "Reals"}], "]"}]}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WorkingPrecision", "->", "prec"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PrecisionGoal", "->", 
          RowBox[{"cprec", "/", "2"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"AccuracyGoal", "->", "Infinity"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"clf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<ValuesOnGrid\>\"", "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"slf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<ValuesOnGrid\>\"", "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Disable", " ", "possibility", " ", "of", " ", "run"}], "-", 
        "away"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"prec", ">=", "110"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ArcTan", "[", 
            RowBox[{"clf", ",", "slf"}], "]"}], ",", 
           FractionBox["1", 
            RowBox[{
             SuperscriptBox["clf", "2"], "+", 
             SuperscriptBox["slf", "2"]}]]}], "}"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Check", " ", "for", " ", "convergence"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "!=", "end"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Precision increased for {\[Zeta], \[Xi]} =\>\"", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Zeta]", ",", "\[Xi]"}], "}"}], "//", "N"}], 
           ",", "\"\<and now WorkingPrecision=\>\"", ",", 
           RowBox[{"{", "prec", "}"}]}], "]"}], ";", 
         RowBox[{"(*", 
          RowBox[{"sol", "=", 
           RowBox[{"VPSSolve", "[", 
            RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "l", ",", "sign", ",", 
             RowBox[{"prec", "+", "10"}], ",", "tol"}], "]"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"VPSSolve", "[", 
           RowBox[{"\[Zeta]0", ",", "\[Xi]0", ",", "l", ",", "sign", ",", 
            RowBox[{"prec", "+", "10"}], ",", "tol", ",", "outall"}], "]"}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"outall", "==", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ArcTan", "[", 
            RowBox[{"clf", ",", "slf"}], "]"}], ",", 
           FractionBox["1", 
            RowBox[{
             SuperscriptBox["clf", "2"], "+", 
             SuperscriptBox["slf", "2"]}]]}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"clf", ",", " ", "slf", ",", 
           RowBox[{"ArcTan", "[", 
            RowBox[{"clf", ",", "slf"}], "]"}], ",", 
           FractionBox["1", 
            RowBox[{
             SuperscriptBox["clf", "2"], "+", 
             SuperscriptBox["slf", "2"]}]]}], "}"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
