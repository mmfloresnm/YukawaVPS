Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["TCompute", "Code"], "[", 
   RowBox[{
    RowBox[{"\[Zeta]0_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Xi]0_", "?", "NumericQ"}], ",", 
    RowBox[{"khat0", ":", 
     RowBox[{"_", "?", "NumericQ"}], ":", "1"}], ",", 
    RowBox[{"sign", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "1"}], ",", 
    RowBox[{"prec", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "32"}], ",", 
    RowBox[{"tol", ":", 
     RowBox[{"_", "?", "NumericQ"}], ":", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]", ",", "\[Xi]", ",", "khat", ",", " ", "Ck", ",", "g01OVERk", ",",
       "CkD", ",", "g01OVERkD", ",", "Tt"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "khat0", "]"}], "==", "1"}], ",", 
       RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "khat"}], "}"}], "=", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sign", " ", 
           RowBox[{"Abs", "[", "\[Zeta]0", "]"}]}], ",", 
          RowBox[{"Abs", "[", "\[Xi]0", "]"}], ",", " ", 
          RowBox[{"Abs", "[", "khat0", "]"}]}], "}"}], ",", "wprec"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Ck", ",", " ", "g01OVERk"}], "}"}], "=", 
      RowBox[{"LinCoeffCalc", "[", 
       RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "sign"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"CkD", ",", " ", "g01OVERkD"}], "}"}], "=", 
      RowBox[{"LinCoeffCalc", "[", 
       RowBox[{
        RowBox[{"\[Zeta]", "*", "khat"}], ",", "\[Xi]", ",", "sign"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Tt", " ", "=", " ", 
      RowBox[{"g01OVERk", " ", "-", " ", 
       RowBox[{
        FractionBox["1", "khat"], "g01OVERkD"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "Tt", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
