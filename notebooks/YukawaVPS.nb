Cell[TextData[{
 StyleBox["trimZeros", "Code",
  FontSlant->"Italic"],
 "  -- Takes a numeric string and removes trailing zeros after the decimal \
point, then removes a dangling decimal point. \n\n",
 StyleBox["Examples:",
  FontWeight->"Bold"],
 " ",
 "\[OpenCurlyDoubleQuote]2.50\[CloseCurlyDoubleQuote] \[RightArrow] \
\[OpenCurlyDoubleQuote]2.5\[CloseCurlyDoubleQuote], \n\t\t   \
\[OpenCurlyDoubleQuote]3.00\[CloseCurlyDoubleQuote] \[RightArrow] \
\[OpenCurlyDoubleQuote]3\[CloseCurlyDoubleQuote], \n\t\t   \
\[OpenCurlyDoubleQuote]10\[CloseCurlyDoubleQuote] \[RightArrow] \
\[OpenCurlyDoubleQuote]10\[CloseCurlyDoubleQuote] (integers untouched)."
}], "Text",
 CellChangeTimes->{{3.957238754306014*^9, 3.957238900288803*^9}, {
  3.9572389356337137`*^9, 3.9572389793828707`*^9}, {3.999598689341704*^9, 
  3.9995987225318203`*^9}, {3.999598880996037*^9, 3.999598902563114*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"d1a2b05a-2a7f-49f5-a9af-cb0cf8c2ace7"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "trimZeros", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trimZeros", "[", "s_String", "]"}], ":=", 
  RowBox[{"StringReplace", "[", 
   RowBox[{
    RowBox[{"StringReplace", "[", 
     RowBox[{"s", ",", 
      RowBox[{
       RowBox[{"RegularExpression", "[", "\"\<(\\\\.\\\\d*?)0+$\>\"", "]"}], 
       "->", "\"\<$1\>\""}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
     "->", "\"\<\>\""}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9995987201650143`*^9, 3.999598720169444*^9}, {
  3.999599222770348*^9, 3.999599226096925*^9}},
 CellLabel->
  "In[405]:=",ExpressionUUID->"fb468692-db88-4a92-88ab-c10ae34ed2ba"],

