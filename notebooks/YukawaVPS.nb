Cell[TextData[{
 StyleBox["importPhaseShiftData", "Code"],
 "\nImport phase shift data for a given partial wave. One can also specify \
attractive \[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote] or repulsive \
\[OpenCurlyDoubleQuote]R\[CloseCurlyDoubleQuote].\n\n",
 StyleBox["Usage",
  FontWeight->"Bold"],
 ":\n\t",
 StyleBox["th0 = importPhaseShiftData[grid, \[OpenCurlyDoubleQuote]A\
\[CloseCurlyDoubleQuote], 0];", "Code"],
 "\nor\n",
 StyleBox["\t ths = importPhaseShiftData[grid, \[OpenCurlyDoubleQuote]Types\
\[CloseCurlyDoubleQuote] -> \
{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote]}, \
\[OpenCurlyDoubleQuote]lValues\[CloseCurlyDoubleQuote] -> {0, 1, 2}];\n\t th0 \
= ths[{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote], 0}];", "Code"],
 "\n\nNote that the assumed data file path is ",
 StyleBox["../data. ", "Code"],
 "\n",
 StyleBox["\nimportPhaseShiftData[grid,\[OpenCurlyDoubleQuote]Types\
\[CloseCurlyDoubleQuote]->{\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote]},\
\[OpenCurlyDoubleQuote]lValues\[CloseCurlyDoubleQuote]->{0, 1, 2}, \
\[OpenCurlyDoubleQuote]OutputDirectory\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]/new_dir/\[CloseCurlyDoubleQuote]]", "Code"]
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
