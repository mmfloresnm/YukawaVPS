Cell[BoxData[
 RowBox[{
  RowBox[{"paramConv", "[", 
   RowBox[{
    RowBox[{"mDM_", "?", "NumericQ"}], ",", 
    RowBox[{"mmed_", "?", "NumericQ"}], ",", 
    RowBox[{"vrel_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Alpha]_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Mu]", ",", "k", ",", "\[Zeta]", ",", "\[Xi]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Mu]", " ", "=", " ", 
      RowBox[{"mDM", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", " ", "=", " ", 
      RowBox[{"\[Mu]", " ", "*", " ", "vrel"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"\[Zeta]", "=", 
      RowBox[{"\[Alpha]", "/", "vrel"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Xi]", "=", 
      RowBox[{"\[Mu]", " ", "*", 
       RowBox[{
        RowBox[{"Abs", "[", "\[Alpha]", "]"}], "/", "mmed"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", "\[Zeta]", ",", "\[Xi]"}], "}"}], ",", "wprec"}], 
       "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
