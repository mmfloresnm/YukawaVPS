Cell[BoxData[
 RowBox[{
  RowBox[{"exportData", "[", 
   RowBox[{"path_", ",", "data_", ",", "l_", ",", 
    RowBox[{"sign_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PS", ",", "SF"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "!=", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"PS", ",", "SF"}], "}"}], "=", "data"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sign", "==", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"path", "<>", "\"\</PhaseShift_A_l=\>\"", "<>", 
           RowBox[{"IntegerString", "[", 
            RowBox[{"l", ",", "10", ",", "3"}], "]"}], "<>", "\"\<.txt\>\""}],
           ",", "PS", ",", "\"\<Table\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"path", "<>", "\"\</Sommerfeld_A_l=\>\"", "<>", 
           RowBox[{"IntegerString", "[", 
            RowBox[{"l", ",", "10", ",", "3"}], "]"}], "<>", "\"\<.txt\>\""}],
           ",", "SF", ",", "\"\<Table\>\""}], "]"}], ";"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"path", "<>", "\"\</PhaseShift_R_l=\>\"", "<>", 
           RowBox[{"IntegerString", "[", 
            RowBox[{"l", ",", "10", ",", "3"}], "]"}], "<>", "\"\<.txt\>\""}],
           ",", "PS", ",", "\"\<Table\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
