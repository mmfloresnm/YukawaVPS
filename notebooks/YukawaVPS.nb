Cell[BoxData[
 RowBox[{"Clear", "[", 
  StyleBox["IrregSolve", "Code"], "]"}]], "Input",
 CellChangeTimes->{{3.996553566844741*^9, 3.996553569633066*^9}},
 CellLabel->
  "In[224]:=",ExpressionUUID->"a5fa972e-755b-43f8-9e27-5e710fe9cd25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IrregSolve", "[", 
   RowBox[{
    RowBox[{"\[Zeta]0_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Xi]0_", "?", "NumericQ"}], ",", 
    RowBox[{"sign", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "1"}], ",", 
    RowBox[{"prec", ":", 
     RowBox[{"_", "?", "IntegerQ"}], ":", "32"}], ",", 
    RowBox[{"tol", ":", 
     RowBox[{"_", "?", "NumericQ"}], ":", 
     FractionBox["1", 
      SuperscriptBox["10", "3"]]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]", ",", "\[Xi]", ",", "l", ",", "xf", ",", "clf", ",", " ", 
      "slf", ",", "\[Theta]0", ",", "S0", ",", "xi", ",", "sol"}], "}"}], ",",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "sign", "]"}], "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Abs[sign] != 1, terminating\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]", ",", "\[Xi]"}], "}"}], "=", 
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sign", " ", 
           RowBox[{"Abs", "[", "\[Zeta]0", "]"}]}], ",", 
          RowBox[{"Abs", "[", "\[Xi]0", "]"}]}], "}"}], ",", "wprec"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"xf", " ", "=", " ", 
      RowBox[{"calcxmax", "[", 
       RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "l"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xi", " ", "=", " ", 
      RowBox[{"calcxmin", "[", 
       RowBox[{"\[Zeta]", ",", "\[Xi]", ",", "l"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"clf", ",", " ", "slf", ",", "\[Theta]0", ",", "S0"}], "}"}], "=", 
      RowBox[{"VPSSolve", "[", 
       RowBox[{
       "\[Zeta]", ",", "\[Xi]", ",", "l", ",", "sign", ",", "prec", ",", 
        "tol", ",", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", " ", "=", " ", 
      RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"cl", "'"}], "[", "x", "]"}], "==", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Vv", "[", 
              RowBox[{"x", ",", "\[Zeta]", ",", "\[Xi]"}], "]"}]}], " ", "*", 
            
            RowBox[{"hy", "[", 
             RowBox[{"l", ",", "x"}], "]"}], " ", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
