Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SsCoul", "[", 
    RowBox[{"l_", "?", "IntegerQ"}], "]"}], "[", 
   RowBox[{"\[Zeta]_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "\[Pi]", " ", "\[Zeta]"}], 
    RowBox[{"1", "-", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Pi]", " ", "\[Zeta]"}], "]"}]}]], "*", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"1", " ", "+", " ", 
      FractionBox[
       SuperscriptBox["\[Zeta]", "2"], 
       SuperscriptBox["j", "2"]]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "l"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.990153492076182*^9, 3.990153573921156*^9}, {
  3.993781481623515*^9, 3.993781486841031*^9}, {3.9937832530543222`*^9, 
