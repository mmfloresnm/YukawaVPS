     RowBox[{
     "\[Zeta]min", ",", "\[Zeta]max", ",", "\[Xi]min", ",", "\[Xi]max", ",", 
      "n\[Xi]", ",", "n\[Zeta]", ",", " ", "grid"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Zeta]min", ",", "\[Zeta]max"}], "}"}], "=", 
      "\[Zeta]range"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Xi]min", ",", "\[Xi]max"}], "}"}], "=", "\[Xi]range"}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"n\[Xi]", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Log10", "[", "\[Xi]max", "]"}], "-", 
          RowBox[{"Log10", "[", "\[Xi]min", "]"}]}], ")"}], "/", 
        RowBox[{"Log10", "[", "\[CapitalDelta]\[Xi]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n\[Zeta]", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Log10", "[", "\[Zeta]max", "]"}], "-", 
          RowBox[{"Log10", "[", "\[Zeta]min", "]"}]}], ")"}], "/", 
        RowBox[{"Log10", "[", "\[CapitalDelta]\[Zeta]", "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"grid", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             SuperscriptBox["10", "log\[Xi]"], ",", 
             SuperscriptBox["10", "log\[Zeta]"]}], " ", "}"}], "//", "N"}], ",", 
          RowBox[{"{", 
           RowBox[{"log\[Xi]", ",", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"Log10", "[", "\[Xi]min", "]"}], ",", 
              RowBox[{"Log10", "[", "\[Xi]max", "]"}], ",", "n\[Xi]"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"log\[Zeta]", ",", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"Log10", "[", "\[Zeta]min", "]"}], ",", 
              RowBox[{"Log10", "[", "\[Zeta]max", "]"}], ",", "n\[Zeta]"}], 
             "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"path", ",", "\"\<zetaVSxi_grid.txt\>\""}], "}"}], "]"}], ",",
        "grid", ",", "\"\<Table\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
