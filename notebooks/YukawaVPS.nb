Cell[TextData[{
 StyleBox["importTData", "Code"],
 "\nImport ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "(", 
    RowBox[{"k", ",", 
     SubscriptBox["k", "\[Diamond]"]}]}], TraditionalForm]],ExpressionUUID->
  "764fbd3e-6334-45df-aec1-037239037255"],
 ") data. At present, the only available data is l = 0. However, the module \
is written to accommodate the inclusion for future data.\n\n",
 StyleBox["Usage",
  FontWeight->"Bold"],
 ":\n\t",
 StyleBox["T0 = importTData[grid, \[OpenCurlyDoubleQuote]A\
\[CloseCurlyDoubleQuote], 0];", "Code"]
}], "Text",
