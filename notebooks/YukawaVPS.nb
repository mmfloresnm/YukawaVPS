Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "importTData", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TFile", "[", 
     RowBox[{"datDIR_String", ",", "type_String", ",", "l_Integer"}], "]"}], ":=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"datDIR", ",", 
       RowBox[{"$YukawaLabels", "[", "type", "]"}], ",", "\"\<T\>\"", ",", 
       RowBox[{"\"\<T_\>\"", "<>", "type", "<>", "\"\<_l=\>\"", "<>", 
        RowBox[{"IntegerString", "[", 
         RowBox[{"l", ",", "10", ",", "3"}], "]"}], "<>", "\"\<.txt\>\""}]}], 
      "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "importTData", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Types\>\"", "->", 
       RowBox[{"{", "\"\<A\>\"", "}"}]}], ",", 
      RowBox[{"\"\<lValues\>\"", "->", 
       RowBox[{"{", "0", "}"}]}], ",", 
      RowBox[{"\"\<OutputDirectory\>\"", "->", "\"\<../data/\>\""}]}], 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"importTData", "[", 
    RowBox[{"grid_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"<|", "|>"}]}], ",", 
       RowBox[{"datDIR", "=", 
        RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}]}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"{", 
           RowBox[{"type", ",", "l"}], "}"}], "]"}], "=", 
         RowBox[{"importDataOnGrid", "[", 
          RowBox[{
           RowBox[{"TFile", "[", 
            RowBox[{"datDIR", ",", "type", ",", "l"}], "]"}], ",", "grid"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"type", ",", 
          RowBox[{"OptionValue", "[", "\"\<Types\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", 
          RowBox[{"OptionValue", "[", "\"\<lValues\>\"", "]"}]}], "}"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "data"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"importTData", "[", 
   RowBox[{"grid_", ",", "type_String", ",", "l_Integer", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"importDataOnGrid", "[", 
   RowBox[{
    RowBox[{"TFile", "[", 
     RowBox[{
      RowBox[{"OptionValue", "[", "\"\<OutputDirectory\>\"", "]"}], ",", 
      "type", ",", "l"}], "]"}], ",", "grid"}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.001329894755793*^9, 4.001329894756454*^9}},
 CellLabel->
  "In[254]:=",ExpressionUUID->"f54a5dc4-57ef-48d1-848d-a4d388dfbec0"]
}, Closed]],

