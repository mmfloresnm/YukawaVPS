Cell[TextData[{
 StyleBox["dataOutput", "Code"],
 "\nModule for performing multi-dimensional scan ",
 StyleBox["for fixed",
  FontWeight->"Bold"],
 " ",
 "\[ScriptL]. Excludes (see commented line) points where 10 \[Zeta]  < \[Xi].\
\nThe sign parameter determines nature of the force (+1 for attractive, -1 \
for repulsive)"
}], "Text",
 CellChangeTimes->{{3.95724980216707*^9, 3.957249802998601*^9}, {
