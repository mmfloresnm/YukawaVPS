Cell[BoxData[
 RowBox[{
  RowBox[{"exportDataGrid", "[", 
   RowBox[{"path_", ",", "\[Zeta]range_", ",", "\[Xi]range_", ",", 
    RowBox[{"\[CapitalDelta]\[Zeta]_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
