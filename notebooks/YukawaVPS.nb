Cell[TextData[{
 StyleBox["PhysVPSSolve", "Code"],
 " \nIdentical to ",
 StyleBox["VPSSolve", "Code"],
 " but allows for input of the physical parameters rather than their \
non-dimensional equivalents."
}], "Text",
