       RowBox[{
        RowBox[{"-", 
         RowBox[{"Abs", "[", 
          FractionBox["\[Zeta]", "\[Xi]"], "]"}]}], "*", "x"}], "]"}]}], ",", 
     "wprec"}], "]"}]}], ";"}]], "Input",
