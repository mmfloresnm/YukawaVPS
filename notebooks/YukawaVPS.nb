Cell[TextData[{
 StyleBox["logTickLabels", "Code",
  FontSlant->"Italic"],
 " -- Create ticks of the type ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["10", "x"], " "}], TraditionalForm]],ExpressionUUID->
  "61929642-eff1-471e-af7b-d02b2c7716ce"],
 "separated by powers with step size ",
 StyleBox["step. ",
  FontSlant->"Italic"],
 StyleBox["Does not ",
  FontWeight->"Bold"],
 "include subticks between orders of magnitude."
}], "Text",
 CellChangeTimes->{{3.957238754306014*^9, 3.957238900288803*^9}, {
  3.957238997262752*^9, 3.957238999199253*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"1612ca36-084c-4bb1-aa5a-8b4a02648da5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logTickLabels", "[", 
   RowBox[{"min_", ",", "max_", ",", 
    RowBox[{"step_", ":", "1"}], ",", 
    RowBox[{"style_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
       RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "logMin", ",", "logMax", ",", "mainExponents", ",", "subExponents", ",", 
      "mainTicks", ",", "subTicks"}], "}"}], ",", 
    RowBox[{
     RowBox[{"logMin", "=", 
      RowBox[{"Floor", "[", 
       RowBox[{"Log10", "[", "min", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"logMax", "=", 
      RowBox[{"Ceiling", "[", 
       RowBox[{"Log10", "[", "max", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mainExponents", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"logMin", ",", "logMax", ",", "step"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"subExponents", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"logMin", ",", "logMax"}], "]"}], ",", "mainExponents"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mainTicks", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "e"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"e", "==", "0"}], ",", "\"\<1\>\"", ",", 
              RowBox[{"Superscript", "[", 
               RowBox[{"10", ",", "e"}], "]"}]}], "]"}], ",", "style"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "mainExponents"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"subTicks", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "e"}], ",", "\"\<\>\""}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Subticks", " ", "with", " ", "no", " ", "label"}], "*)"}], 
        RowBox[{"{", 
         RowBox[{"e", ",", "subExponents"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"mainTicks", ",", "subTicks"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.956999257295052*^9, 3.956999257296834*^9}, 
   3.9592230559437227`*^9, 3.999138112544827*^9, {3.999138606321705*^9, 
   3.999138610130761*^9}},
 CellLabel->
  "In[395]:=",ExpressionUUID->"a1ec5089-5b7f-4f17-89ac-1f7348f3c241"],

Cell[TextData[{
 StyleBox["logTicksWithSubticks", "Code",
  FontSlant->"Italic"],
 " -- Create ticks of the type ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["10", "x"], " "}], TraditionalForm]],ExpressionUUID->
  "d0f88d49-b9f2-4e54-acd6-a7eafa36ef5b"],
 " with subticks."
}], "Text",
 CellChangeTimes->{{3.957238754306014*^9, 3.957238900288803*^9}, {
  3.957238992867962*^9, 3.957238993483176*^9}},
 Background->GrayLevel[
  0.85],ExpressionUUID->"bbadbec5-af67-4348-9daa-1bfc593de824"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logTicksWithSubticks", "[", 
   RowBox[{"min_", ",", "max_", ",", 
    RowBox[{"style_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
       RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"exps", ",", "majors", ",", "minors", ",", 
      RowBox[{"base", "=", "10"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"exps", "=", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Ceiling", "[", 
         RowBox[{"Log10", "[", "min", "]"}], "]"}], ",", 
        RowBox[{"Floor", "[", 
         RowBox[{"Log10", "[", "max", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"majors", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"base", "^", "e"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"e", "==", "0"}], ",", "\"\<1\>\"", ",", 
              RowBox[{"Superscript", "[", 
               RowBox[{"10", ",", "e"}], "]"}]}], "]"}], ",", "style"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "exps"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"minors", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"val", "=", 
              RowBox[{"m", "*", 
               RowBox[{"base", "^", 
                RowBox[{"exps", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}]}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"val", ">=", "min"}], "&&", 
               RowBox[{"val", "<=", "max"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"val", ",", "\"\<\>\""}], "}"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Length", "[", "exps", "]"}], "-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "2", ",", "9"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"majors", ",", "minors"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.95922292406386*^9, 3.959222940218425*^9}, {
  3.999138115022801*^9, 3.999138115274987*^9}},
 CellLabel->
  "In[396]:=",ExpressionUUID->"4fc3739d-3bc3-4bbc-82a8-96a397aefcde"]
}, Closed]],

